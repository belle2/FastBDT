from setuptools import setup, find_packages

_install_requires = [
    'numpy>=1.20',
]
# pytest is only needed to run the Python interface tests, so it is added as a
# requirement only when FastBDT is built with testing enabled.
_build_testing = "@BUILD_TESTING@".upper() in ("ON", "TRUE", "1", "YES")
if _build_testing:
    _install_requires.append('pytest>=6.0')

setup(
    name='PyFastBDT',
    version='@FastBDT_VERSION_MAJOR@.@FastBDT_VERSION_MINOR@',
    author='Thomas Keck, The Belle II Collaboration',
    author_email='software@belle2.org',
    description='Stochastic gradient-boosted decision trees for multivariate classification.',
    url='https://github.com/belle2/FastBDT',
    packages=find_packages(),
    include_package_data=True,
    package_data={
        'PyFastBDT': ['*.so', '*.dylib'],
    },
    classifiers=[
        'Programming Language :: Python :: 3',
        'License :: OSI Approved :: GNU General Public License v3 (GPLv3)',
    ],
    python_requires='>=3.7',
    install_requires=_install_requires,
)
